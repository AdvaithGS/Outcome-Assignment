 "rentroll_001": {"sheet": "Willow Creek Commons", "record_start": {"column": "A", "pattern": "\\d{3}-\\d{3}"},
   "record_end": {"column": "G", "pattern": "Charge Total.*"},
   "columns": {"unit_number": "A", "unit_type_code": "B", "unit_square_feet": "C", "unit_status": "D", "resident_name": "E"},
   "block_fields": {"market_rent": {"mode": "first", "column": "F"}, "deposit_held": {"mode": "first", "column": "K"},
