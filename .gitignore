# Secrets: never commit the key
.env

# Provided data: the brief forbids committing sample documents or answers
sample/sample-data-documents/
sample/sample-data-output-validated/

# Local environments, caches, build output
venv/
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# Caches and dumps hold text extracted from the sample documents: never commit
.cache/
experiments/*/dumps/

# per-mode duplicates of outputs/ (regenerated for $0 in replay mode)
experiments/e2a/M/
experiments/e2a/C/
experiments/e2a/H/
