# Contract-mandated gateway (all model calls go through these two)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Cache: off | read_write | replay | refresh
LLM_CACHE_MODE=read_write
# LLM_CACHE_PATH=.cache/llm_cache.sqlite

# Spend ledger and budget guard (dev). Unset caps = no limit (the production default).
# LLM_LEDGER_PATH=ledger/spend.jsonl
LLM_BUDGET_USD=9.00
# LLM_RUN_BUDGET_USD=0.50
# LLM_RUN_ID=eval-001

# Ask OpenRouter to include usage.cost in responses (1/0)
LLM_REQUEST_USAGE=1
